{
  "//": "Type-check do entrypoint serverless (api/index.ts). Só este arquivo é responsabilidade desta config; packages/api tem tsconfig próprio. Garante que o handler tipa contra @vercel/node.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "api/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "packages/*/dist"
  ]
}